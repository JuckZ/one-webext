{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2023"
    ],
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "strict": true,
    "declaration": true,
    "declarationMap": false,
    "noEmitOnError": true,
    "outDir": "dist",
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
