{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "element-plus/global",
      "webextension-polyfill"
    ],
    "paths": {
      "@oneweb/module-sdk": [
        "packages/module-sdk/src/index.ts"
      ],
      "@oneweb/module-sdk/capability-client": [
        "packages/module-sdk/src/capability-client.ts"
      ],
      "@oneweb/module-sdk/capability-rpc": [
        "packages/module-sdk/src/capability-rpc.ts"
      ],
      "@oneweb/module-sdk/runtime": [
        "packages/module-sdk/src/runtime-client.ts"
      ],
      "@oneweb/module-sdk/storage-module": [
        "packages/module-sdk/src/storage-module.ts"
      ],
      "~/*": [
        "src/*"
      ]
    }
  },
  "exclude": [
    "dist",
    "extension",
    "node_modules",
    "packages/module-sdk/dist"
  ]
}
